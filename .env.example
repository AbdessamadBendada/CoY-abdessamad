# CoY · Winback Agent
# Copy to .env.local. Use sandbox/test accounts locally; never paste production
# secrets into this file. See SETUP-AND-LAUNCH-GUIDE.md for every field.

# Application and Supabase (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Application secrets (required; generate a different value per environment)
ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
SCORING_API_KEY=
CRON_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Stripe billing (required for checkout/billing; use test values locally)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_COY_MONTHLY=price_replace_me

# Mistral AI (required for scoring and action generation)
MISTRAL_API_KEY=

# Brevo email/SMS (required before any message is sent)
BREVO_API_KEY=xkeysib-replace_me
BREVO_SENDER_EMAIL=test-sender@example.com
BREVO_SMS_SENDER=CoYTest
BREVO_WEBHOOK_SECRET=

# Shopify OAuth (required to offer Shopify connection)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Gorgias OAuth (optional unless the Gorgias connector is offered)
GORGIAS_CLIENT_ID=
GORGIAS_CLIENT_SECRET=

# Trigger.dev background jobs (required for scheduled processing)
TRIGGER_PROJECT_REF=proj_replace_me
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Internal alerts (strongly recommended in staging/production)
INTERNAL_ALERT_EMAIL=

# Langfuse AI tracing (optional; set all three or none)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://eu.cloud.langfuse.com

# Upstash distributed rate limiting (optional; set both or neither)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Crisp is implemented but hidden/deferred in the current UI (optional)
CRISP_PLUGIN_IDENTIFIER=
CRISP_PLUGIN_KEY=

# Developer diagnostics only (optional)
ANALYZE=false

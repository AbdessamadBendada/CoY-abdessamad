    "@trigger.dev/sdk": "^4.4.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.35.2",
    "langfuse": "^3.38.6",
    "lucide-react": "^0.575.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "pg": "^8.19.0",
    "prisma": "^6.19.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",

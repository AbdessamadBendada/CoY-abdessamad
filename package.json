{
  "name": "winback-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "rm -f .next/dev/lock && rm -rf .next/cache/pack",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "analyze": "ANALYZE=true prisma generate && next build --webpack",
